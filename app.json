{
  "expo": {
    "name": "powercouple",
    "slug": "power-couple-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "powercouple",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F1",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "powercouple uses the camera so you can snap photo proof that you finished a goal.",
        "NSPhotoLibraryUsageDescription": "powercouple lets you pick a photo from your library as proof that you finished a goal."
      },
      "bundleIdentifier": "com.baris.powercouple"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.baris.powercouple"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "powercouple lets you pick a photo from your library as proof that you finished a goal.",
          "cameraPermission": "powercouple uses the camera so you can snap photo proof that you finished a goal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
